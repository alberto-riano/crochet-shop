SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: leave empty for SQLite (local dev), or set Postgres URL for production
# DATABASE_URL=postgres://user:password@localhost:5432/crochet_shop
DATABASE_URL=

# S3 Storage
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=eu-north-1

# S3 environment prefix: 'dev' for local, 'prod' for production
# Files are stored under s3://bucket/{S3_ENV}/... so dev and prod never collide
S3_ENV=dev
